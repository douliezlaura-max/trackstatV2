{
  "title": "Comet Tracker ingest payload",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "game": {
          "type": "string",
          "const": "adopt_me"
        },
        "account": {
          "type": "object",
          "properties": {
            "robloxUserId": {
              "description": "Roblox UserId of the account running the collector",
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\d{1,20}$"
                },
                {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              ]
            },
            "displayName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "description": "Name shown on the dashboard"
            }
          },
          "required": [
            "robloxUserId",
            "displayName"
          ],
          "additionalProperties": false
        },
        "stats": {
          "type": "object",
          "properties": {
            "bucks": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "Bucks balance"
            },
            "pets": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "Number of pets in inventory"
            },
            "eggs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "Number of unhatched eggs in inventory"
            }
          },
          "required": [
            "bucks",
            "pets",
            "eggs"
          ],
          "additionalProperties": false,
          "description": "Adopt Me stats"
        },
        "sentAt": {
          "description": "When the collector took the reading: ISO 8601 string or Unix seconds. Informational only.",
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            },
            {
              "type": "number",
              "minimum": 0
            }
          ]
        }
      },
      "required": [
        "game",
        "account",
        "stats"
      ],
      "additionalProperties": false
    },
