# --- Database (matches docker-compose.yml) ---
DATABASE_URL="postgresql://comet:comet@localhost:5432/comet_tracker?schema=public"

# --- NextAuth ---
# Public URL of the app. Use https://... in production (switches to __Secure- cookies).
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-me"

# --- Discord OAuth (https://discord.com/developers/applications) ---
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# --- Server ---
PORT=3000
HOSTNAME="0.0.0.0"

# --- Dev-only login bypass ---
# Lets you sign in as a fake user without Discord. Ignored when NODE_ENV=production.
DEV_LOGIN_BYPASS="false"

# --- scripts/simulate-collector.ts ---
# An API key created in the "Connect Script" modal (or printed by `npm run db:seed`).
COMET_API_KEY=""
COMET_URL="http://localhost:3000"
